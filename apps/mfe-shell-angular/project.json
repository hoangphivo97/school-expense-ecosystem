{
  "name": "mfe-shell-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mfe-shell-angular/src",
  "prefix": "app",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/mfe-shell-angular",
        "index": "apps/mfe-shell-angular/src/index.html",
        "main": "apps/mfe-shell-angular/src/main.ts",
        "polyfills": ["zone.js", "@angular/localize/init"],
        "tsConfig": "apps/mfe-shell-angular/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src/lib/i18n",
            "output": "assets/i18n"
          },
          {
            "input": ".",
            "glob": "CHANGELOG.md",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/mfe-shell-angular/src/styles.scss",
          "node_modules/bootstrap/dist/css/bootstrap-grid.min.css",
          "node_modules/bootstrap/dist/css/bootstrap-utilities.min.css"
        ],
        "scripts": [],
        "customWebpackConfig": {
          "path": "apps/mfe-shell-angular/webpack.config.ts"
        },
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/ui/src/lib/ui/styles"]
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/mfe-shell-angular/src/app/environments/environment.ts",
              "with": "apps/mfe-shell-angular/src/app/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1MB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kB",
              "maximumError": "12kB"
            }
          ],
          "outputHashing": "all",
          "optimization": true,
          "buildOptimizer": true,
          "customWebpackConfig": {
            "path": "apps/mfe-shell-angular/webpack.prod.config.ts"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": {
            "scripts": true,
            "styles": true,
            "hidden": false,
            "vendor": false
          }
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:module-federation-dev-server",
      "options": {
        "port": 4200,
        "publicHost": "http://localhost:4200"
      },
      "configurations": {
        "production": {
          "buildTarget": "mfe-shell-angular:build:production"
        },
        "development": {
          "buildTarget": "mfe-shell-angular:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "polyfills": ["zone.js", "zone.js/testing", "@angular/localize/init"],
        "tsConfig": "apps/mfe-shell-angular/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src/lib/i18n",
            "output": "."
          }
        ],
        "styles": ["apps/mfe-shell-angular/src/styles.scss"],
        "scripts": []
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "firebase deploy --only hosting:mfe-shell-angular --token \"{args.token}\" --non-interactive"
        ]
      }
    }
  }
}